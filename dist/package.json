{
  "name": "@toclocoinc/lattice-grid",
  "version": "1.31.1",
  "description": "Lattice Grid — high performance JavaScript data grid. TOCLOCO Inc.",
  "keywords": [
    "data-grid",
    "datagrid",
    "table",
    "spreadsheet",
    "virtual-scroll",
    "vanilla-js",
    "react",
    "vue",
    "svelte",
    "excel-export",
    "pivot"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "TOCLOCO Inc",
  "homepage": "https://www.latticegrid.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toclocoinc/latticegrid.git"
  },
  "type": "module",
  "main": "./lattice-grid.min.cjs",
  "module": "./lattice-grid.esm.min.js",
  "types": "./lattice-grid.d.ts",
  "style": "./lattice-grid.min.css",
  "exports": {
    ".": {
      "types": "./lattice-grid.d.ts",
      "import": "./lattice-grid.esm.min.js",
      "require": "./lattice-grid.min.cjs",
      "default": "./lattice-grid.esm.min.js"
    },
    "./modules/*": {
      "types": "./lattice-grid.d.ts",
      "default": "./modules/*.esm.min.js"
    },
    "./modules/*.js": "./modules/*.js",
    "./modules/*.cjs": "./modules/*.cjs",
    "./css": "./lattice-grid.min.css",
    "./lattice-grid.css": "./lattice-grid.min.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {}
}
