{
  "name": "@toclocoinc/lattice-grid",
  "version": "1.71.0",
  "description": "Lattice Grid JS: a high-performance JavaScript data grid for millions of rows, live data sources and zero runtime dependencies, free on localhost and licensed per domain to ship.",
  "keywords": [
    "data-grid",
    "datagrid",
    "table",
    "spreadsheet",
    "virtual-scroll",
    "vanilla-js",
    "angular",
    "react",
    "vue",
    "svelte",
    "excel-export",
    "pivot"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "TOCLOCO Inc",
  "homepage": "https://www.latticegrid.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toclocoinc/latticegrid.git"
  },
  "type": "module",
  "main": "./lattice-grid.min.cjs",
  "module": "./lattice-grid.esm.min.js",
  "types": "./lattice-grid.d.ts",
  "style": "./lattice-grid.min.css",
  "exports": {
    ".": {
      "types": "./lattice-grid.d.ts",
      "import": "./lattice-grid.esm.min.js",
      "require": "./lattice-grid.min.cjs",
      "default": "./lattice-grid.esm.min.js"
    },
    "./modules/*": {
      "types": "./modules/*.d.ts",
      "default": "./modules/*.esm.min.js"
    },
    "./modules/*.js": "./modules/*.js",
    "./modules/*.cjs": "./modules/*.cjs",
    "./angular": {
      "types": "./angular/types/toclocoinc-lattice-grid-angular.d.ts",
      "default": "./angular/fesm2022/toclocoinc-lattice-grid-angular.mjs"
    },
    "./angular/package.json": "./angular/package.json",
    "./svelte/*.svelte": {
      "svelte": "./svelte/*.svelte",
      "default": "./svelte/*.svelte"
    },
    "./css": "./lattice-grid.min.css",
    "./lattice-grid.css": "./lattice-grid.min.css",
    "./package.json": "./package.json",
    "./docs/warnings.json": "./docs/warnings.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "svelte": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
